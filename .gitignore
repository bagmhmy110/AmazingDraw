# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
ENV/

# ── 运行时配置（含本机路径，不入库）──
# 仓库里保留 config.example.json 作为模板
config.json
card_engine_core/config.json
scripts/config.json
*.local.json

# ── 用户数据 ──
data/cards/
data/albums/
data/*.db
user_presets/*.local.*
~/.amazingdraw/

# ── 日志 ──
logs/
*.log
*.log.*
scripts/webui/logs/

# ── 临时文件 ──
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# ── 系统 ──
Thumbs.db
desktop.ini
.DS_Store

# ── 编辑器 ──
.vscode/
.idea/
*.sublime-*

# ── 本地实验/备份 ──
_scratch/
_backup/
*.orig
*.rej

# ── 编译产物（如需发布二进制请手动 git add -f）──
# 注：card_engine_core/native/*.pyd 是项目的一部分，
# 默认保留；如果只想发源码，取消下面注释
# card_engine_core/native/*.pyd
